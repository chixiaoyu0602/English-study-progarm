{
  "name": "marknote",
  "version": "1.1.0",
  "private": true,
  "description": "拾光笔记 · 英语精读、语法标注与离线单词本",
  "author": "chixiaoyu0602",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js && playwright test",
    "test:unit": "node --test tests/*.test.js",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:linux": "npm run build && electron-builder --linux dir --x64"
  },
  "devDependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.chixiaoyu.marknote",
    "productName": "MarkNote",
    "artifactName": "MarkNote-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "build/icon.png",
      "package.json"
    ],
    "npmRebuild": false,
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "MarkNote-${version}-Windows-x64.exe"
    },
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
